{
  "name": "pi-tmux-subagents",
  "version": "0.1.0",
  "description": "Minimal tmux-backed Pi subagents",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "pi-package",
    "pi",
    "tmux",
    "subagents"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.72.1",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "agents",
    "dist/src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "dist/src/index.js"
    ]
  },
  "types": "dist/src/index.d.ts"
}
