{
  "name": "pi-tmux-subagents",
  "version": "0.2.0",
  "description": "Pi extension for Markdown-defined, tmux-backed subagents and parallel coding-agent delegation",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "author": "masta-g3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masta-g3/pi-tmux-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/masta-g3/pi-tmux-subagents/issues"
  },
  "homepage": "https://github.com/masta-g3/pi-tmux-subagents#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "agent",
    "subagents",
    "tmux",
    "tmux-subagents",
    "markdown-agents",
    "parallel-agents",
    "agent-delegation",
    "agent-orchestration",
    "extension",
    "session-manager",
    "coding-agent"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@types/node": "^20.19.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "agents",
    "dist/src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "dist/src/index.js"
    ]
  }
}
